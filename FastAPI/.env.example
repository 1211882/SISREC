# Copy this file to .env and fill in the real values.
# NEVER commit the real .env (it is git-ignored).

# PostgreSQL connection
POSTGRES_URI=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
POSTGRES_DB=postgres

# JWT signing key — generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-with-a-random-secret

# Optional JWT tuning
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed CORS origins (frontend URLs)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
